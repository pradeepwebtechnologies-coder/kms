{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "black",
					"name": "Black",
					"color": "#0b0b0b"
				},
				{
					"slug": "charcoal",
					"name": "Charcoal",
					"color": "#151515"
				},
				{
					"slug": "saffron",
					"name": "Saffron",
					"color": "#ff7a18"
				},
				{
					"slug": "amber",
					"name": "Amber",
					"color": "#ff9a3c"
				},
				{
					"slug": "saffron-light",
					"name": "Saffron (light)",
					"color": "#ffb870"
				},
				{
					"slug": "saffron-text",
					"name": "Saffron (text on light backgrounds)",
					"color": "#b45309"
				},
				{
					"slug": "gold",
					"name": "Gold",
					"color": "#fbbf24"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#fffaf4"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1c130c"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				}
			],
			"defaultDuotone": false,
			"duotone": []
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1180px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"defaultSpacingSizes": false
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Merriweather (headings)",
					"fontFamily": "\"Merriweather\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "body",
					"name": "Inter (text)",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", \"Noto Sans Devanagari\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9rem"
				},
				{
					"slug": "medium",
					"name": "Normal",
					"size": "1.08rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.3rem"
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "clamp(1.65rem, 3.2vw, 2.35rem)"
				}
			],
			"defaultFontSizes": false
		},
		"shadow": {
			"defaultPresets": false
		}
	}
}
